{
  "name": "coolisimplify",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "check:clone-payload": "node --experimental-strip-types scripts/check-clone-payload.mjs",
    "check:clone-names": "node --experimental-strip-types scripts/check-clone-names.mjs",
    "check:envs": "node --experimental-strip-types scripts/check-envs.mjs",
    "check:app-detail": "node --experimental-strip-types scripts/check-app-detail.mjs",
    "check:logs": "node --experimental-strip-types scripts/check-logs.mjs",
    "check:deploy-verdict": "node --experimental-strip-types --disable-warning=DEP0205 --import ./scripts/register-alias.mjs scripts/check-deploy-verdict.mjs"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
